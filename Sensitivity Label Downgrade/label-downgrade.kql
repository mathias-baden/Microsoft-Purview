// ============================================================================
// Sensitivity Label Downgrade Detection — Microsoft 365 Defender Advanced Hunting
//
// EXAMPLE DATA ONLY. The label IDs and names below are placeholders.
// You MUST replace them with your own tenant's labels before this query
// returns anything meaningful — see readme.md, "Step 1" (Get-Label).
// ============================================================================

// Define a function to map label IDs to human-readable names.
// Replace these example IDs/names with your tenant's (one line per label).
let listLabelNames = (labelID: string) {
    case(
        labelID == "00000000-0000-0000-0000-000000000001", "Public",
        labelID == "00000000-0000-0000-0000-000000000002", "General",
        labelID == "00000000-0000-0000-0000-000000000003", "Confidential",
        labelID == "00000000-0000-0000-0000-000000000004", "Confidential - HR",
        labelID == "00000000-0000-0000-0000-000000000005", "Highly Confidential",
        labelID == "00000000-0000-0000-0000-000000000006", "Highly Confidential - Specific People",
        labelID == "00000000-0000-0000-0000-000000000007", "HR",
        "Sensitivity Label displayName not found"
    )
};
// Query the CloudAppEvents table for specific action types related to sensitivity labels.
CloudAppEvents
| where ActionType in~ (
    "FileSensitivityLabelChanged",
    "FileSensitivityLabelRemoved",
    "SensitivityLabelRemoved"
)
// Parse the RawEventData column to extract JSON data.
| extend data = parse_json(tostring(RawEventData))
// Determine the SourceFileName based on the ActionType.
| extend SourceFileName = iif(
    ActionType == "FileSensitivityLabelChanged",
    tostring(data.SourceFileName),
    tostring(data.ObjectId)
)
// Extract the SiteUrl from the parsed JSON data.
| extend SiteUrl = data.SiteUrl
// Concatenate justification text from the sensitivity label event data.
| extend SensitivityLabelJustificationText = strcat(
    tostring(data.SensitivityLabelEventData.JustificationText),
    tostring(data.SensitivityLabelJustificationText)
)
// Extract the old and new sensitivity label IDs from the event data.
| extend SourceLabel = data.SensitivityLabelEventData.OldSensitivityLabelId
| extend DestinationLabel = data.SensitivityLabelEventData.SensitivityLabelId
// Filter: source label is in the "sensitive" tier and destination label is not.
// Both lists below MUST be the same set of IDs — the IDs you consider sensitive.
// (Example tier: HR, Confidential - HR, Highly Confidential, Highly Confidential - Specific People)
| where SourceLabel in ("00000000-0000-0000-0000-000000000007", "00000000-0000-0000-0000-000000000004", "00000000-0000-0000-0000-000000000005", "00000000-0000-0000-0000-000000000006")
    and DestinationLabel !in ("00000000-0000-0000-0000-000000000007", "00000000-0000-0000-0000-000000000004", "00000000-0000-0000-0000-000000000005", "00000000-0000-0000-0000-000000000006")
// Project the desired columns, using listLabelNames() for readable label names.
| project
    Timestamp,
    AccountDisplayName,
    SourceLabelName = listLabelNames(SourceLabel),
    DestinationLabelName = listLabelNames(DestinationLabel),
    SensitivityLabelJustificationText,
    SourceFileName,
    Application,
    UserAgent,
    SiteUrl,
    ActionType,
    AccountId,
    AccountObjectId,
    SourceLabel,
    DestinationLabel,
    ReportId,
    RawEventData
| sort by Timestamp desc
